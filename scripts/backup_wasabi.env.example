# Copy to ~/.config/wcg-backup/env and chmod 600. Never commit the real file.
# Wasabi endpoint depends on the bucket's region, e.g. s3.wasabisys.com (us-east-1),
# s3.eu-central-1.wasabisys.com, s3.us-west-1.wasabisys.com.
RESTIC_REPOSITORY=s3:https://s3.eu-central-1.wasabisys.com/YOUR-BUCKET/worldcountrygroups
AWS_ACCESS_KEY_ID=YOUR_WASABI_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_WASABI_SECRET_KEY
# Encryption password for the backups. Store a copy somewhere safe (password manager):
# without it the backups cannot be restored.
RESTIC_PASSWORD=CHANGE_ME
