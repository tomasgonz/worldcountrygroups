__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
.pytest_cache/
.mypy_cache/

# Nuxt site
site/node_modules/
site/.nuxt/
site/.output/
site/*.log

# API keys
scripts/.env

# Speech text files (~10K files, reproducible via scripts/import_ungdc.py)
site/server/data/speeches/

# Speech PDFs (large, reproducible)
site/server/data/pdfs-80/

# Speech index (large, reproducible via scripts)
site/server/data/un-speeches-index.json

# User data
site/server/data/users.json

# Secrets and per-user / runtime state (never commit)
site/server/data/ai-config.json
site/server/data/digest-state.json
site/server/data/ai-analysis-cache.json
site/server/data/cron-config.json
site/server/data/*.tmp

# Feeds regenerated every few hours by cron (reproducible via scripts/fetch_*.py)
site/server/data/news-feed.json
site/server/data/statements-feed.json

# Downloaded speech PDFs for every session (large, reproducible)
site/server/data/pdfs-*/

# Derived from the speech index by scripts/build_quotes.py
site/server/data/quotes-index.json

# Derived people directory (scripts/build_people.py)
site/server/data/people-index.json
site/server/data/people-wikidata.json

# Research desk question log (user data)
site/server/data/asks/
